# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.eslintcache
*.tsbuildinfo
dist/
build/
.next/
.cache/
coverage/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/
.python-version.local

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Logs / temp ---
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# --- Editors ---
.vscode/
.idea/

# --- Third-party clones (own git repos; see README "Setup") ---
external/*
!external/.gitkeep

# --- Images are tracked on purpose (screenshots, diagrams, demo assets) ---
# Nothing here ignores *.png / *.jpg / *.svg / *.gif; the negations guard against
# a future pattern above catching them.
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.webp

# --- Archived prototype and local agent instruction files ---
track3/
CLAUDE.md
GEMINI.md

# --- Local runtime data (controller state, artifacts, proof runs) ---
.local-data*/
/tmp_*
guard/tmp_*
e2e/tmp_*
web/.qa/
